# Export these in PHP-FPM / shell OR return the same keys from config/local.php.
# Never put config/local.php, var/, or server/ under the web document root.
YOUCAM_API_KEY=
YOUCAM_API_BASE_URL=https://yce-api-01.perfectcorp.com
# Keep false until a read-only provider check confirms the account, cost, and units.
YOUCAM_LIVE_ENABLED=false
THREADROOM_RUNTIME_DIR=
THREADROOM_GLOBAL_UNIT_BUDGET=300
THREADROOM_JUDGING_RESERVE_UNITS=300
THREADROOM_SESSION_TASK_LIMIT=12
THREADROOM_GLOBAL_TASK_LIMIT=150
THREADROOM_SECURE_COOKIE=true
